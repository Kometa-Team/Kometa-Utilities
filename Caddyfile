status.{$KOMETA_DOMAIN:kometa.wiki} {
    # Uptime Kuma dashboard (uptime monitoring & status page)
    reverse_proxy uptime-kuma:3001
}


utilities.{$KOMETA_DOMAIN:kometa.wiki} {
    # Handle errors (like when the backend is down)
    handle_errors {
        @maintenance expression {err.status_code} in [502, 503, 504]
        handle @maintenance {
            rewrite * /maintenance.html
            file_server {
                root /var/www/html
            }
        }
    }

    # Official "Use Kometa App" Trakt OAuth backend: the browser asks the
    # Flask service for an authorization URL and later to exchange the code.
    # The official client secret lives only in the container's environment.
    # Only /api/official/* is proxied: the legacy /api/start and
    # /api/exchange-code endpoints accept a user-supplied client_secret and
    # must not be reachable through this server.
    handle /trakt-oauth/api/official/* {
        uri strip_prefix /trakt-oauth
        reverse_proxy trakt-oauth:5000
    }

    # Handle /trakt-oauth path
    # Static browser-only Trakt OAuth: BYO credentials and tokens are exchanged
    # directly between the user's browser and Trakt; nothing sensitive
    # touches this server. The registered Trakt Redirect uri remains
    # https://utilities.kometa.wiki/trakt-oauth/callback
    handle /trakt-oauth* {
        root * /var/www/html
        # Serve the SPA for the OAuth callback (query string is preserved)
        @traktCallback path /trakt-oauth/callback
        rewrite @traktCallback /trakt-oauth/index.html
        header Cache-Control "no-store"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    # MAL token exchange proxy - same-origin passthrough to MyAnimeList.
    # MAL's OAuth endpoints send no CORS headers, so the static page cannot
    # fetch myanimelist.net directly from the browser; it POSTs here instead
    # and Caddy forwards the form body untouched. Nothing is stored.
    handle /mal-oauth/api/token* {
        rewrite * /v1/oauth2/token
        reverse_proxy https://myanimelist.net {
            header_up Host myanimelist.net
        }
    }

    # Official "Use Kometa App" MyAnimeList OAuth backend: the browser asks
    # the Flask service for an authorization URL and later to exchange the code.
    # MAL's PKCE flow needs no client_secret, so the official secret never
    # reaches the browser; the server holds it in its environment.
    handle /mal-oauth/api/official/* {
        uri strip_prefix /mal-oauth
        reverse_proxy mal-oauth:5000
    }

    # Handle /mal-oauth path
    # Static browser-only MyAnimeList OAuth: BYO credentials and tokens are held
    # only in the user's browser; the token exchange transits the same-origin
    # proxy above. Register https://utilities.kometa.wiki/mal-oauth/callback
    # as the App Redirect URL in the MAL application.
    handle /mal-oauth* {
        root * /var/www/html
        # Serve the SPA for the OAuth callback (query string is preserved)
        @malCallback path /mal-oauth/callback
        rewrite @malCallback /mal-oauth/index.html
        header Cache-Control "no-store"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    # ========================================================================
    # Optional: Basic Authentication
    # ========================================================================
    # Uncomment to require authentication for all routes
    # Generate password hash: caddy hash-password
    # basicauth * {
    #     username $2a$14$your_bcrypt_hash_here
    # }

    # Handle /anidb-service path
    # NOTE: uri strip_prefix removes /anidb-service before sending to backend
    # FastAPI receives /stats instead of /anidb-service/stats
    handle /anidb-service* {
        uri strip_prefix /anidb-service
        reverse_proxy anidb-mirror:8000 {
            header_up X-Script-Name /anidb-service
        }
    }

    # Handle /plex-oauth path
    # Static browser-only Plex OAuth (PIN flow): the browser talks directly to
    # plex.tv, which is CORS-enabled; the token never touches this server.
    handle /plex-oauth* {
        root * /var/www/html
        header Cache-Control "no-store"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    # Handle /trakt-mal-oauth path
    # Flask app for Trakt and MyAnimeList OAuth authentication
    handle /trakt-mal-oauth* {
        uri strip_prefix /trakt-mal-oauth
        reverse_proxy trakt-mal-oauth:5000
    }

    # Handle /simkl-oauth path
    # Static browser-only SIMKL OAuth (PIN flow): the browser talks directly to
    # api.simkl.com, which is CORS-enabled; this client needs no secret, so the
    # token never touches this server.
    handle /simkl-oauth* {
        root * /var/www/html
        header Cache-Control "no-store"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    # Handle /simkl-service path
    # NOTE: uri strip_prefix removes /simkl-service before sending to backend
    # FastAPI receives /stats instead of /simkl-service/stats
    handle /simkl-service* {
        uri strip_prefix /simkl-service
        reverse_proxy simkl-service:8000 {
            header_up X-Script-Name /simkl-service
        }
    }

    # FlickList device-code proxy - same-origin passthrough to FlickList.
    # FlickList's /api/auth endpoints send no CORS headers (confirmed via a
    # live OPTIONS preflight against /api/auth/device/code), so the static
    # page cannot fetch flicklist.tv directly from the browser; it POSTs here
    # instead and Caddy forwards the request untouched. No client_secret is
    # used anywhere in this flow, so nothing sensitive touches this server.
    handle /flicklist-oauth/api/device/code* {
        rewrite * /api/auth/device/code
        reverse_proxy https://flicklist.tv {
            header_up Host flicklist.tv
        }
    }

    handle /flicklist-oauth/api/device/token* {
        rewrite * /api/auth/device/token
        reverse_proxy https://flicklist.tv {
            header_up Host flicklist.tv
        }
    }

    # Handle /flicklist-oauth path
    # Static browser-only FlickList OAuth (device-code flow): the browser
    # polls through the same-origin proxy above; the resulting fs_live_...
    # key never touches this server, only the user's browser.
    handle /flicklist-oauth* {
        root * /var/www/html
        header Cache-Control "no-store"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        file_server
    }

    # WeTrakr device-code proxy - same-origin passthrough to WeTrakr.
    # WeTrakr's /oauth/device/* endpoints send no CORS headers (confirmed via
    # a live OPTIONS preflight on 2026-09-28), so the static
    # page cannot fetch api.wetrakr.com directly from the browser; it POSTs
    # here instead and Caddy forwards the request untouched. No client_secret
    # is used anywhere in this flow, so nothing sensitive touches this server.
    handle /wetrakr-oauth/api/device/code* {
        rewrite * /oauth/device/code
        reverse_proxy https://api.wetrakr.com {
            header_up Host api.wetrakr.com
        }
    }

    handle /wetrakr-oauth/api/device/token* {
        rewrite * /oauth/device/token
        reverse_proxy https://api.wetrakr.com {
            header_up Host api.wetrakr.com
        }
    }

    # Handle /wetrakr-oauth path
    # Static browser-only WeTrakr OAuth (device-code flow): the browser
    # polls through the same-origin proxy above; the resulting access and
    # refresh tokens never touch this server, only the user's browser.
    handle /wetrakr-oauth* {
        root * /var/www/html
        header Cache-Control "no-store"
        header Referrer-Policy "no-referrer"
        header X-Content-Type-Options "nosniff"
        file_server
    }
    # Handle /imdb-service path
    # NOTE: uri strip_prefix removes /imdb-service before sending to backend
    # FastAPI receives /stats instead of /imdb-service/stats
    handle /imdb-service* {
        uri strip_prefix /imdb-service
        reverse_proxy imdb-service:8000 {
            header_up X-Script-Name /imdb-service
        }
    }

    # Handle root path - serve static landing page
    handle / {
        root * /var/www/html
        file_server
    }

    # Fallback for any other paths
    handle {
        respond "Service not found" 404
    }
}

