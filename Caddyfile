# Domain for all Kometa service hostnames. Override with KOMETA_DOMAIN in
# the environment (see .env); defaults to the production domain.
#
# Caddyfile Example for AniDB Service
# Copy this file to 'Caddyfile' and customize for your deployment

# ============================================================================
# PATH-BASED ROUTING (Multiple services on one domain)
# ============================================================================

floppy.{$KOMETA_DOMAIN:kometa.wiki} {
    # Handle errors
    handle_errors {
        @maintenance expression {err.status_code} in [502, 503, 504]
        handle @maintenance {
            rewrite * /floppy-maintenance.html
            file_server {
                root /var/www/html
            }
        }
    }

    reverse_proxy floppy:8000
}

translations.{$KOMETA_DOMAIN:kometa.wiki} {
    # Access logging with real client IPs (added 2026-09-21 after scraper flood)
    log {
        output file /data/access/translations.log {
            roll_size 50MiB
            roll_keep 5
            roll_keep_for 336h
        }
        format json
    }

    # Handle errors
    handle_errors {
        @maintenance expression {err.status_code} in [502, 503, 504]
        handle @maintenance {
            rewrite * /translations-maintenance.html
            file_server {
                root /var/www/html
            }
        }
    }

    reverse_proxy weblate:8080
}


