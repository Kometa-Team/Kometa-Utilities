# AniDB Service Configuration
# Copy this file to .env and update with your actual values

# === AniDB API Configuration ===
ANIDB_CLIENT=kometaofficial
ANIDB_VERSION=1
ANIDB_PROTO_VER=1

# AniDB Authentication (required for accessing mature/18+ content)
# Register at: https://anidb.net/
ANIDB_USERNAME=your_anidb_username
ANIDB_PASSWORD=your_anidb_password

# === Rate Limiting ===
DAILY_LIMIT=200
THROTTLE_SECONDS=4
# Fallback cache lifetime, used only when an entry's XML can't be parsed
UPDATE_THRESHOLD_DAYS=7

# === Abuse Protection ===
# Only requests that would add a NEW (uncached) AID to the queue are limited; cache hits and
# refreshes are never limited.
NEW_LOOKUPS_PER_IP=50           # uncached AIDs one IP may queue per window (0 = off)
NEW_LOOKUP_WINDOW_SECONDS=3600
NEW_LOOKUPS_PER_IP_DAILY=100    # uncached AIDs one IP may queue per rolling 24h (0 = off)
MAX_QUEUED_NEW=5000             # reject new AIDs while this many are already waiting (0 = off)
MAX_AID=50000                   # reject uncached AIDs above this (real AIDs are ~20,000); 0 = off
# Header holding the client IP (last value is used). Caddy sets X-Forwarded-For to the real
# client address. If a CDN/proxy such as Cloudflare is ever put in front of Caddy, every client
# will appear as the CDN's address; change this (e.g. CF-Connecting-IP) and set Caddy's
# trusted_proxies first, or all users will share one limit.
CLIENT_IP_HEADER=X-Forwarded-For

# === Refresh Tiers (days a cached entry stays fresh) ===
# Chosen per entry from its start/end dates, so finished shows don't use up the daily budget
REFRESH_DAYS_ACTIVE=14          # airing, open-ended, upcoming, or end date in the future
REFRESH_DAYS_UNKNOWN=30         # no start date
REFRESH_DAYS_ENDED_UNDER_1Y=30
REFRESH_DAYS_ENDED_1_3Y=90
REFRESH_DAYS_ENDED_3_10Y=180
REFRESH_DAYS_ENDED_10Y_PLUS=365

# === File Paths (Docker defaults) ===
XML_DIR=/app/data
DB_PATH=/app/database/anidb.db
SEED_DATA_DIR=/app/seed_data

# === Path-Based Routing (Optional) ===
# Leave empty for subdomain deployment (anidb-service.yourdomain.com)
# Set to /anidb-service for path-based deployment (yourdomain.com/anidb-service)
# IMPORTANT: This must match the path in your Caddyfile
ROOT_PATH=/anidb-service

# === Backup Configuration ===
# Backups are created locally in ./backups/
# Optional: Use S3-compatible storage for off-site backups

# === AWS S3 / DigitalOcean Spaces Configuration ===
# For AWS S3: Use your AWS credentials and leave S3_ENDPOINT empty
# For DigitalOcean Spaces: Use Spaces keys and set the endpoint
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=nyc3
S3_BUCKET_NAME=anidb-backups
# For DigitalOcean Spaces, set the endpoint (leave empty for AWS S3)
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
