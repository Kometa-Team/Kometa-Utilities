# Copy to .env on the Oracle VM. Values marked "copy" come from the root .env on
# the current host (keep them in sync; .env is never committed).

# --- Networking / storage (VM-specific) ---
# The VM's Tailscale IP (`tailscale ip -4`); the service listens only there.
BIND_ADDR=100.x.y.z
# Host path of the mounted block volume.
IMDB_DATA_DIR=/mnt/imdb-data

# --- Import ---
# An import needs ~24 GiB free (22.7 GiB staging copy + downloads).
MIN_FREE_DISK_GB=26

# --- Admin (copy) ---
IMDB_ADMIN_TOKEN=

# --- IMDb GraphQL / parental guides (copy) ---
# IMDb has refused GraphQL from some datacenter IPs; the proxy pool gets
# through. Oracle's IPs may or may not be blocked, so keep the proxies on.
PARENTAL_PROXY_ENABLED=true
PARENTAL_PROXY_URLS=
IMDB_GRAPHQL_PROXY_ENABLED=true
PARENTAL_HTTP_ENABLED=false
PARENTAL_BROWSER_ENABLED=false
PARENTAL_PREFETCH_ENABLED=true
