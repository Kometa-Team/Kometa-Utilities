# FlickList OAuth Configuration
# Copy this file to .env and update with your actual values.
#
# The FlickList app's public client_id is NOT read from this file — it is a
# committed constant in static/index.html (matching the current SIMKL/Plex
# pattern: this identifier is public by design, no client_secret is used
# anywhere in FlickList's device-code flow, and it's already visible in every
# request the page makes). See FLICKLIST_CLIENT_ID in static/index.html —
# it needs a real value once a Kometa-Team FlickList developer account has
# registered an app (currently an open item; see project notes).

SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# === Optional ===
# Set to /flicklist-oauth for path-based routing behind a reverse proxy (e.g. Caddy)
# Leave empty for subdomain deployment (flicklist-oauth.yourdomain.com)
ROOT_PATH=/flicklist-oauth

# Flask server settings (local development only — gunicorn ignores these)
PORT=8080
HOST=127.0.0.1
