# SIMKL OAuth Configuration
# Copy this file to .env and fill in your values

# === Required ===
# SIMKL AUTH V2 app credentials — obtain from https://simkl.com/settings/developer/
# CLIENT_ID is also embedded in static/index.html (it is public); CLIENT_SECRET
# is used only here, to authenticate the device-code token exchange, and must
# never be placed in the static page.
CLIENT_ID=your_simkl_client_id
CLIENT_SECRET=your_simkl_client_secret

# No REDIRECT_URI: the AUTH V2 device flow performs no browser redirect.

# === Optional ===
# Set to /simkl-oauth for path-based routing behind a reverse proxy (e.g. Caddy)
# Leave empty for subdomain deployment (simkl-oauth.yourdomain.com)
ROOT_PATH=/simkl-oauth

# Flask server settings (local development only — gunicorn ignores these)
PORT=8080
HOST=127.0.0.1
DEBUG=False
