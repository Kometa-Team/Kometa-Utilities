# Never bake secrets into image layers: the Dockerfile uses `COPY . .`, and
# python-dotenv would then load these from inside the container, silently
# overriding the environment compose passes in.
.env
.env.*
!.env.example

# Build/test noise
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
