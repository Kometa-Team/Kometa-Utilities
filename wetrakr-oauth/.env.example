# WeTrakr OAuth Configuration
# Copy this file to .env and update with your actual values.
#
# The WeTrakr app's public client_id is NOT read from this file — it is a
# committed constant in static/index.html (matching FlickList's pattern in
# this repo: the identifier is public by design — it's sent as the
# wetrakr-api-key header on every request the page makes — and no
# client_secret is used anywhere in WeTrakr's device-code flow). See
# WETRAKR_CLIENT_ID in static/index.html. The value there is the id
# registered 2026-09-27; which WeTrakr account owns it long-term is still an
# open item (see project notes) — it is not necessarily the final one.

SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# === Optional ===
# Set to /wetrakr-oauth for path-based routing behind a reverse proxy (e.g. Caddy)
# Leave empty for subdomain deployment (wetrakr-oauth.yourdomain.com)
ROOT_PATH=/wetrakr-oauth

# Flask server settings (local development only — gunicorn ignores these)
PORT=8080
HOST=127.0.0.1
